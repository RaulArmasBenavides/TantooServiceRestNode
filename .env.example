# Copia este archivo a .env y completa los valores. .env no se sube al repositorio.

# Puerto HTTP del servicio (por defecto 3700; el frontend apunta a http://localhost:3700/api)
PORT=3700

# Cadena de conexión de MongoDB usada por src/database/config.ts
DB_CNN2=mongodb+srv://<usuario>:<password>@<cluster>/<base>?retryWrites=true&w=majority

# Secreto para firmar y verificar los JWT (src/helpers/jwt.ts, src/middlewares/validar-jwt.ts)
# Usa un valor largo y aleatorio. Es obligatorio: el servicio no arranca sin él.
JWT_SECRET=<cadena-aleatoria-larga>

# Variables presentes en el .env de desarrollo pero no usadas por el código actual
# DB_CNN=
# GOOGLE_ID=
# GOOGLE_SECRET=
